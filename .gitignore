# Build output. The directory itself is kept so that Docker does not
# create it as root on a fresh clone.
_site/*
!_site/.gitkeep

# Dependencies
node_modules/

# Nix / direnv / devbox
.direnv/
.devbox/
result
result-*

# Python leftovers from the old setup
.venv/
__pycache__/

# Local environment and secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*

# Editors and OS
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
