<a class="skip-link" href="#main">Skip to content</a>

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="site-header__logo" href="/">
      <span class="sitename">{{ site.title }}</span>
    </a>

    <button class="nav-toggle" type="button"
            aria-expanded="false" aria-controls="navmenu" aria-label="Open menu">
      {% set name = "menu" %}{% include "icon.njk" %}
      {% set name = "close" %}{% include "icon.njk" %}
    </button>

    <nav id="navmenu" class="navmenu" aria-label="Main">
      <ul>
        {%- for item in site.nav %}
        {%- set current = (item.url == "/" and page.url == "/") or (item.url != "/" and page.url.startsWith(item.url)) %}
        <li>
          <a href="{{ item.url }}"{% if current %} aria-current="page"{% endif %}>{{ item.label }}</a>
        </li>
        {%- endfor %}
      </ul>
    </nav>
  </div>
</header>
